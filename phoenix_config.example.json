{
  "phoenix": {
    "version": "1.0.0",
    "name": "Phoenix",
    "description": "Assistant vocal de sante mentale"
  },
  "llm": {
    "provider": "ollama",
    "default_model": "qwen2.5:0.5b",
    "available_models": [
      {"id": "qwen2.5:0.5b", "name": "Qwen 2.5 0.5B", "default": true},
      {"id": "qwen2.5:1.5b", "name": "Qwen 2.5 1.5B"},
      {"id": "smollm2:360m", "name": "SmolLM2 360M", "use_case": "fallback_only"},
      {"id": "smollm2:1.7b", "name": "SmolLM 1.7B"}
    ],
    "lora": {"enabled": true, "adapter_path": null},
    "architecture": {
      "mode": "collaborative",
      "description": "ChatterBot+Kuzu gere les intents connus, LLM gere le fallback",
      "intent_coverage_target": 0.9,
      "llm_usage": "fallback_only"
    },
    "ollama_url": "http://localhost:11434",
    "temperature": 0.5,
    "max_tokens": 200
  },
  "stt": {
    "engine": "vosk",
    "model": "vosk-model-small-fr-0.22",
    "model_path": "VOSK_MODEL_PATH",
    "sample_rate": 16000,
    "language": "fr",
    "description": "Reconnaissance vocale. Moteurs: vosk (hors-ligne leger, defaut), whisper (faster-whisper, qualite max), dummy (tests). Le core n'expose qu'une interface: doc/design_stt_tts_plugins.md"
  },
  "tts": {
    "engine": "piper",
    "voice": "fr_FR-siwis-medium",
    "voice_path": "PIPER_VOICE_PATH",
    "piper_path": "PIPER_BIN_PATH",
    "sample_rate": 22050,
    "description": "Synthese vocale. Moteurs: piper (leger, Pi), kokoro (ONNX, temps reel sur CPU desktop), pico (pico2wave ultra leger), dummy (tests). Exemple kokoro: { \"engine\": \"kokoro\", \"model_path\": \"kokoro-v1.0.onnx\", \"voices_path\": \"voices-v1.0.bin\", \"voice\": \"af_heart\", \"language\": \"fr\" }"
  },
  "memory": {
    "kuzu_graph": "phoenix",
    "kuzu_path": "./phoenix.kuzu",
    "save_conversations": true,
    "max_history": 50
  },
  "safety": {
    "crisis_detection": true,
    "emergency_numbers": {
      "FR": "3114",
      "CA": "1-866-APPELLE",
      "US": "988",
      "BE": "1813",
      "CH": "143",
      "QC": "1-866-APPELLE"
    },
    "auto_escalate": true
  },
  "languages": ["fr", "en", "es", "de", "it", "pt"],
  "wake_word": {
    "enabled": true,
    "word": "hey phoenix",
    "presets": ["hey phoenix", "hey mycroft", "phoenix", "mycroft", "custom", "none"]
  },
  "chatterbot": {
    "enabled": true,
    "installed": true,
    "backend": "ladybug",
    "threshold": 0.55,
    "corpora": ["chatterbot", "mycroft"],
    "description": "Corpus conversationnels (ChatterBot + Mycroft) stockes dans LadybugDB: data/chatterbot/<lang>_corpus.lbdb (verrouillee) + <lang>_user.lbdb (apprentissage)",
    "install_command": "pip install chatterbot==1.2.14 chatterbot-corpus-py real_ladybug pyyaml click",
    "import_command": "python -m mycroft.lora.mycroft_corpus import --lang fr --skills <dossier_skills_mycroft> --data-dir data --chatterbot-corpus"
  },
  "ai": {
    "enabled": true,
    "priority": 6,
    "timeout_s": 10,
    "description": "Fournisseurs d'IA externes en failover (priorite 5 du IntentMatcher, apres LadybugChatter, avant le fallback). Chaque reponse est apprise dans LadybugDB. type 'local' = pipeline Phoenix lui-meme (defaut).",
    "providers": [
      {"id": "local", "type": "local", "description": "Pipeline Phoenix local (defaut)"},
      {"id": "ollama", "type": "ollama", "host": "localhost", "port": 11434, "model": "qwen2.5:1.5b"},
      {"id": "satellite", "type": "mycroft", "url": "http://192.168.1.10:8090", "api_key_env": "PHOENIX_TOKEN"},
      {"id": "dev", "type": "opencode", "directory": "D:/mycroft-phoenix bon/opencode"},
      {"id": "openai", "type": "openai", "model": "gpt-4o-mini", "api_key_env": "OPENAI_API_KEY"}
    ]
  },
  "setup": {"completed": false, "first_run": true},
  "web": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 8181,
    "username": "mycroft",
    "password": "CHANGE_ME",
    "description": "Interface web legere (chat + status). Auth par defaut mycroft/CHANGE_ME."
  }
}
